# Published delegator image (ghcr.io/eu-sovereign-cloud/ecp/delegator).
#
# Same binary as the sibling Dockerfile, without the debug apparatus: no delve,
# no `-gcflags=all=-N -l`, alpine instead of debian. That one stays for e2e/KIND
# where attaching a debugger is the point.
#
# One image serves every CSP — the PLUGIN env var selects the controller set
# (aruba, dummy or ionos); see internal/cmd/delegator/main.go.

# --- Build Stage ---
FROM golang:1.26.5-alpine AS build

RUN apk add --no-cache git

WORKDIR /app

COPY go.work go.work
COPY go.work.sum go.work.sum

COPY ci/tools/go/ ci/tools/go/

# Pre-copy module manifests so replace directives resolve before source copy
COPY framework/go.mod framework/go.sum framework/
COPY resource/go.mod resource/go.sum resource/
COPY gateway/go.mod gateway/
COPY csp/aruba/go.mod csp/aruba/go.sum csp/aruba/
COPY csp/dummy/go.mod csp/dummy/go.sum csp/dummy/
COPY csp/ionos/go.mod csp/ionos/go.sum csp/ionos/
COPY test/go.mod test/go.sum test/

WORKDIR /app/test
RUN go mod download

WORKDIR /app
COPY framework/ framework/
COPY resource/ resource/
COPY csp/ csp/
COPY test/ test/

WORKDIR /app/test
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /delegator ./internal/cmd/delegator

# --- Runtime Stage ---
FROM alpine:latest

COPY --from=build /delegator /delegator

# healthz/readyz
EXPOSE 8081

# Numeric and non-root: the charts set runAsNonRoot without runAsUser, so
# kubelet rejects the pod unless the image itself declares a non-zero UID.
USER 65532:65532

ENTRYPOINT ["/delegator"]
