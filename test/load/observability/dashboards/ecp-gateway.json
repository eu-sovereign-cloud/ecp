{
  "uid": "ecp-gateway",
  "title": "ECP Gateway",
  "tags": ["ecp", "gateway"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "component",
        "label": "Component",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(go_goroutines{job=\"ecp-gateway\"}, component)", "refId": "component" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(ecp_gateway_auth_middleware_duration_seconds_count, provider)", "refId": "provider" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Request rate",
      "description": "Authenticated requests per second across all selected providers.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(ecp_gateway_auth_middleware_duration_seconds_count{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "End-to-end p95",
      "description": "95th percentile of authn + authz + handler latency.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 4, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ecp_gateway_auth_middleware_duration_seconds_bucket{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Authz p95 — cached",
      "description": "Checker.Authorize latency for the informer-cache implementation.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 5, "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ecp_gateway_authz_check_duration_seconds_bucket{component=~\"$component\", impl=\"cached\"}[$__rate_interval])))",
          "legendFormat": "cached"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Authz p95 — direct",
      "description": "Checker.Authorize latency for the direct Kubernetes List implementation.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 5, "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ecp_gateway_authz_check_duration_seconds_bucket{component=~\"$component\", impl=\"direct\"}[$__rate_interval])))",
          "legendFormat": "direct"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Request rate by provider",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "stacking": { "mode": "none" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (provider) (rate(ecp_gateway_auth_middleware_duration_seconds_count{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "End-to-end latency quantiles",
      "description": "Histogram buckets span 50us to 3.3s, so sub-millisecond and multi-second paths both resolve.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ecp_gateway_auth_middleware_duration_seconds_bucket{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ecp_gateway_auth_middleware_duration_seconds_bucket{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ecp_gateway_auth_middleware_duration_seconds_bucket{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "p95 latency by provider",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(ecp_gateway_auth_middleware_duration_seconds_bucket{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Mean latency by provider",
      "description": "rate(sum) / rate(count) — cheaper than a quantile and sensitive to tail outliers.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (provider) (rate(ecp_gateway_auth_middleware_duration_seconds_sum{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval])) / sum by (provider) (rate(ecp_gateway_auth_middleware_duration_seconds_count{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Authz check latency — direct vs cached",
      "description": "p95 of Checker.Authorize. The gap between impls is the value of the RBAC cache.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, impl) (rate(ecp_gateway_authz_check_duration_seconds_bucket{component=~\"$component\"}[$__rate_interval])))",
          "legendFormat": "p95 {{impl}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, impl) (rate(ecp_gateway_authz_check_duration_seconds_bucket{component=~\"$component\"}[$__rate_interval])))",
          "legendFormat": "p99 {{impl}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "RBAC fetch latency — direct vs cached",
      "description": "Kubernetes List for direct, informer cache read for cached.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, impl) (rate(ecp_gateway_rbac_fetch_duration_seconds_bucket{component=~\"$component\"}[$__rate_interval])))",
          "legendFormat": "p95 {{impl}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, impl) (rate(ecp_gateway_rbac_fetch_duration_seconds_bucket{component=~\"$component\"}[$__rate_interval])))",
          "legendFormat": "p99 {{impl}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Authz check rate by impl",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (impl) (rate(ecp_gateway_authz_check_duration_seconds_count{component=~\"$component\"}[$__rate_interval]))",
          "legendFormat": "{{impl}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Authz share of request latency",
      "description": "Mean authz time divided by mean end-to-end time. Rising values mean authorization dominates.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(ecp_gateway_authz_check_duration_seconds_sum{component=~\"$component\"}[$__rate_interval])) / sum(rate(ecp_gateway_authz_check_duration_seconds_count{component=~\"$component\"}[$__rate_interval]))) / (sum(rate(ecp_gateway_auth_middleware_duration_seconds_sum{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval])) / sum(rate(ecp_gateway_auth_middleware_duration_seconds_count{component=~\"$component\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "authz share"
        }
      ]
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_goroutines{job=\"ecp-gateway\", component=~\"$component\"}",
          "legendFormat": "{{component}} — {{pod}}"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Heap in use",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_memstats_heap_inuse_bytes{job=\"ecp-gateway\", component=~\"$component\"}",
          "legendFormat": "heap {{component}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_resident_memory_bytes{job=\"ecp-gateway\", component=~\"$component\"}",
          "legendFormat": "rss {{component}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "CPU cores",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 3, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(process_cpu_seconds_total{job=\"ecp-gateway\", component=~\"$component\"}[$__rate_interval])",
          "legendFormat": "{{component}} — {{pod}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "GC pause quantiles",
      "description": "go_gc_duration_seconds is a summary: quantile 0 is min, 1 is max.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_gc_duration_seconds{job=\"ecp-gateway\", component=~\"$component\"}",
          "legendFormat": "q{{quantile}} {{component}}"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "GC rate and heap objects",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(go_gc_duration_seconds_count{job=\"ecp-gateway\", component=~\"$component\"}[$__rate_interval])",
          "legendFormat": "gc/s {{component}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_memstats_heap_objects{job=\"ecp-gateway\", component=~\"$component\"}",
          "legendFormat": "objects {{component}}"
        }
      ]
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Threads and open files",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_threads{job=\"ecp-gateway\", component=~\"$component\"}",
          "legendFormat": "threads {{component}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_open_fds{job=\"ecp-gateway\", component=~\"$component\"}",
          "legendFormat": "open fds {{component}}"
        }
      ]
    },
    {
      "id": 36,
      "type": "timeseries",
      "title": "Scrape health",
      "description": "up == 0 means Prometheus cannot reach the gateway /metrics endpoint.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"ecp-gateway\"}",
          "legendFormat": "{{component}} — {{pod}}"
        }
      ]
    }
  ]
}
